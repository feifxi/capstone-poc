# cp .env.example .env.local

# ทางเลือก A (แนะนำ): LiveKit Cloud free tier — https://cloud.livekit.io
# สร้าง project แล้วเอา 3 ค่านี้มา (Settings > Keys)
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ค่าที่ browser ต้องเห็น = ใส่ URL เดียวกับข้างบน
NEXT_PUBLIC_LIVEKIT_URL=wss://xxxx.livekit.cloud

# ทางเลือก B: self-host ด้วย docker
#   docker run --rm -p 7880:7880 -e LIVEKIT_KEYS="devkey: secretsecretsecretsecretsecret32" livekit/livekit-server
#   LIVEKIT_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secretsecretsecretsecretsecret32
#   NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
