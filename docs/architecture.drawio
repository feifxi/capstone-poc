        <mxCell id="postgres" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="postgres  :5432&#xa;&#xa;ข้อมูลถาวร:&#xa;event · user · ticket&#xa;booth · สรุปหลังงาน&#xa;pgvector (RAG)&#xa;ทุกตารางมี eventId / orgId" vertex="1">
          <mxGeometry height="150" width="220" x="1000" y="170" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="redis  :6379&#xa;&#xa;MVP: ยังไม่ใช้จริง&#xa;วาง interface ไว้&#xa;(PresenceStore)" vertex="1">
          <mxGeometry height="120" width="220" x="1000" y="360" as="geometry" />
