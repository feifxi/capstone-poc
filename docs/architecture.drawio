        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="Connecta — System &amp; Software Architecture (production)" vertex="1">
          <mxGeometry height="30" width="700" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" value="อ้างอิง context หัวข้อ 12 · media เป็น UDP throughput สูง → browser ต่อ LiveKit ตรง ไม่ผ่าน reverse proxy (ข้อนี้กำหนดการเลือก infra ทั้งหมด)" vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="48" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="Browser (ผู้เข้าร่วมงาน)&#xa;&#xa;• Next.js (apps/web) — หน้าเว็บ + guest join&#xa;• Phaser 3 — โลก 2D, เดิน, กล้อง&#xa;• colyseus.js — client state&#xa;• livekit-client — เสียง/วิดีโอ" vertex="1">
          <mxGeometry height="180" width="260" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="vmbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;spacing=8;" value="VM ของมหาวิทยาลัย  —  Docker Compose (6 containers)  ·  Caddy จัดการ TLS อัตโนมัติ" vertex="1">
          <mxGeometry height="620" width="740" x="420" y="90" as="geometry" />
        </mxCell>
        <mxCell id="caddy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="caddy&#xa;(reverse proxy / TLS)&#xa;TCP 80 · 443" vertex="1">
          <mxGeometry height="90" width="160" x="460" y="330" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="api  —  NestJS  :3000&#xa;&#xa;event · ticket · queue 1:1&#xa;LiveKit token + quota&#xa;Guard (role · tenant · owner)&#xa;AI booth bot (RAG)" vertex="1">
          <mxGeometry height="140" width="240" x="700" y="150" as="geometry" />
        </mxCell>
        <mxCell id="realtime" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="realtime  —  Colyseus  :2567&#xa;&#xa;state อายุเท่า session:&#xa;ตำแหน่ง · ใครอยู่ในห้อง&#xa;ใครกำลังพูด · สถานะคิว&#xa;(persist เป็นช่วงๆ ไม่ทุก tick)" vertex="1">
          <mxGeometry height="140" width="240" x="700" y="330" as="geometry" />
        </mxCell>
        <mxCell id="livekit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="livekit  —  SFU  :7880 (signaling)&#xa;UDP 50000–60000 (media)&#xa;&#xa;TURN / TLS ในตัว&#xa;egress (บันทึกวิดีโอ)" vertex="1">
          <mxGeometry height="140" width="240" x="700" y="520" as="geometry" />
